<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.redhat</groupId>
    <artifactId>redhat-kb-mcp</artifactId>
    <version>1.0.0</version>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <cyclonedx-plugin.version>2.9.1</cyclonedx-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <!-- 3.33.x is the current LTS line; 3.33.3.1 carries the security fixes
             for CVE-2026-39852 (quarkus-vertx-http authorization bypass). -->
        <quarkus.platform.version>3.33.3.1</quarkus.platform.version>
        <!-- 2.0.0 implements MCP specification 2026-07-28 (stateless core,
             server/discover) and is built against Quarkus 3.33.3.1, the platform pinned
             above. -->
        <quarkus-mcp-server.version>2.0.0</quarkus-mcp-server.version>
        <jsoup.version>1.21.2</jsoup.version>
        <!-- Test-only tooling. Kept on the latest stable line rather than the newest
             release: AssertJ 4 and WireMock 4 are still milestone/beta. -->
        <assertj.version>3.27.7</assertj.version>
        <archunit.version>1.5.0</archunit.version>
        <wiremock.version>3.13.2</wiremock.version>
        <pitest.version>1.30.0</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <!-- Not managed by the Quarkus BOM (which only manages io.rest-assured's
             validator of the same artifact name), so the version must live here. -->
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
        <keycloak.version>26.7.2</keycloak.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
            <version>${quarkus-mcp-server.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-stdio</artifactId>
            <version>${quarkus-mcp-server.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-cache</artifactId>
        </dependency>
        <!-- OAuth 2.1 Resource Server (Keycloak). The MCP specification requires an
             authenticated HTTP transport to validate bearer tokens and publish
             Protected Resource Metadata (RFC 9728). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <!-- Emits the MCP-conformant WWW-Authenticate challenge pointing at the
             resource metadata document. -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-oidc</artifactId>
            <version>${quarkus-mcp-server.version}</version>
        </dependency>
        <!-- Strips HTML from Knowledge Base article bodies before they reach the model -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- McpAssured: drives the server over the real MCP protocol in tests -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <version>${quarkus-mcp-server.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AssertJ: assertions that report the actual value on failure, not just "false" -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit: turns the layering rules described in AGENTS.md into build failures -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- WireMock: upstream failures StubApiServer cannot express (delays, dropped bodies) -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- A real Keycloak, so audience validation (RFC 8707) is exercised rather than
             switched off as it is in the other @QuarkusTest profiles. Version comes from
             the Quarkus BOM. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-keycloak-server</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Validates a tool's structuredContent against the outputSchema it publishes.
             The specification makes conformance the obligation, not mere presence. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                            <goal>native-image-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                        <!-- Image for the Keycloak that AudienceValidationTest starts. Pinned
                             to a patch rather than a floating tag so a rebuild tests the same
                             authorization server. -->
                        <keycloak.version>${keycloak.version}</keycloak.version>
                        <!-- Plain HTTP: the container's self-signed certificate is not in any
                             trust store, so the HTTPS health probe never completes. The realm
                             is loopback-only and lives for the length of one test class. -->
                        <keycloak.use.https>false</keycloak.use.https>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `./mvnw test -Pmutation` re-runs the suite against deliberately broken copies of
            the code and reports which mutations no test noticed. Coverage says a line ran;
            this says an assertion would have caught it changing. Off by default because it
            re-runs the suite once per mutation.

            Scoped to the classes whose logic decides something — the sanitizer, the fence,
            the limiter, the audit preview, the startup check and the query escaping. The
            formatters and models are rendering and data, where a surviving mutation usually
            means a cosmetic string, not a missing test.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.redhat.kb.mcp.ContentSanitizer</param>
                                <param>com.redhat.kb.mcp.UntrustedFence</param>
                                <param>com.redhat.kb.mcp.RateLimiter</param>
                                <param>com.redhat.kb.mcp.ToolAuditLog</param>
                                <param>com.redhat.kb.mcp.ToolGuards</param>
                                <param>com.redhat.kb.infrastructure.client.SolrQuery</param>
                                <param>com.redhat.kb.infrastructure.config.StartupConfigCheck</param>
                                <param>com.redhat.kb.infrastructure.credential.RedHatCredential</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.redhat.kb.*</param>
                            </targetTests>
                            <!-- Every @QuarkusTest is excluded, and not only for speed: PIT
                                 runs tests in its own minion JVM with no Quarkus lifecycle,
                                 so these do not merely run slowly there, they cannot pass at
                                 all. PIT refuses to start against a suite that is red for
                                 reasons unrelated to mutation, which is what listing them
                                 here prevents. The units below carry the logic anyway. -->
                            <excludedTestClasses>
                                <param>com.redhat.kb.mcp.*ProtocolTest</param>
                                <param>com.redhat.kb.mcp.Mcp*Test</param>
                                <param>com.redhat.kb.mcp.LegacySse*Test</param>
                                <param>com.redhat.kb.mcp.UserToken*Test</param>
                                <param>com.redhat.kb.mcp.StructuredContent*Test</param>
                                <param>com.redhat.kb.mcp.AudienceValidationTest</param>
                                <param>com.redhat.kb.mcp.OutputSchemaConformanceTest</param>
                                <param>com.redhat.kb.mcp.ToolsListInvarianceTest</param>
                                <param>com.redhat.kb.infrastructure.credential.CachePartitioningTest</param>
                            </excludedTestClasses>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            `./mvnw package -Psbom` writes a CycloneDX inventory of the JAR's dependencies.
            The container image already ships one, but the released JAR did not, so a
            consumer auditing it against a new advisory had nothing to read.
        -->
        <profile>
            <id>sbom</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>${cyclonedx-plugin.version}</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>makeAggregateBom</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputName>sbom</outputName>
                            <outputFormat>json</outputFormat>
                            <includeTestScope>false</includeTestScope>
                            <includeProvidedScope>false</includeProvidedScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            `./mvnw package -Pnative` builds the standalone executable. Without this
            profile the flag was silently ignored: Maven only warns about an unknown
            profile, so the command completed and produced an ordinary JVM build while
            appearing to have worked.

            Native matters most for the stdio transport, where an MCP client starts the
            process on demand and pays the JVM's startup cost on every session. Requires
            GraalVM or Mandrel on the PATH (.sdkmanrc pins a GraalVM, so `sdk env` is
            enough); the container-based alternative needs no local toolchain:
            `./mvnw package -Pnative -Dquarkus.native.container-build=true`.
        -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <skipITs>false</skipITs>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${surefire-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <systemPropertyVariables>
                                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                        <maven.home>${maven.home}</maven.home>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
